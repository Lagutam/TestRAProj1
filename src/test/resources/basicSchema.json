{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type":"object",
    "properties":{
        "userID":{
            "type":"integer"
        },
        "id":{
            "type":"integer",
            "minimum": 1,
            "maximum": 20
        },
        "title":{
            "type":"string",
            "minLength": 50
        },
        "body":{
            "type":"string"
        }
    },
    "required":["id","title", "body"]
}